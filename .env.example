# Required — base64 32-byte root key. Every signing key in the database is
# sealed under it, so losing it means every token registre ever issued stops
# verifying and every app has to be re-pointed at a fresh instance.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Required — the URL registre answers as. It is stamped into every token, so
# changing it invalidates everything already issued. Must be https outside
# development. Every app in the suite carries the same value as OIDC_ISSUER.
REGISTRE_ISSUER=https://sso.facile.studio

# Required — internal PostgreSQL credentials (docker-compose builds DATABASE_URL from them)
POSTGRES_USER=registre
POSTGRES_PASSWORD=registre-internal-db
# POSTGRES_DB=registre

# Optional — override only outside docker-compose, which builds this itself
# DATABASE_URL=postgres://registre:registre@localhost:5432/registre?sslmode=disable

# Optional — deployment name: development, staging, production. It is the only
# thing that decides whether a plain-http issuer is tolerated.
# APP_ENV=production

# Optional — API listen port
# PORT=4000

# Optional — debug, info, warn, error
# LOG_LEVEL=info

# Optional — comma-separated CORS origins. Unset denies every cross-origin
# caller, which is what phase 0 wants: machine tokens are fetched server to
# server and no browser calls the token endpoint yet.
# CORS_ALLOWED_ORIGINS=

# Optional — how long an access token lives. Short by default: a machine token
# is renewed by a program, so a short life costs nothing and shrinks the window
# a leaked one is useful for.
# REGISTRE_ACCESS_TOKEN_TTL=1h

# Optional — how long a signing key signs before it is replaced.
# REGISTRE_KEY_ROTATION_INTERVAL=720h

# Optional — how long a new key sits published in the JWKS before it starts
# signing. It has to outlast the key set cache of the slowest relying party, or
# that party 401s every token until it refetches.
# REGISTRE_KEY_PUBLISH_DELAY=15m

# Optional — how long a retired public key stays in the JWKS. Unset, it is twice
# REGISTRE_ACCESS_TOKEN_TTL, which is why docker-compose leaves it empty: pinning
# a literal here silently breaks the relationship the moment somebody raises the
# token lifetime alone. Refused at boot if it is shorter than the token lifetime,
# which would drop a key while tokens it signed are still valid.
# REGISTRE_KEY_RETENTION=

# Optional — how long a refresh grant may be redeemed. It rotates on every
# redemption, and boot refuses a value that is not longer than the access
# token lifetime: a grant that dies before the thing it renews is a login that
# breaks for no reason.
# REGISTRE_REFRESH_TOKEN_TTL=720h

# The proxy addresses whose forwarded-for headers are believed. The login rate
# limiter keys on the remote address, so behind Traefik with this unset every
# human in the suite shares one bucket and nobody can log in.
# TRUSTED_PROXIES=

# Optional — how many argon2 verifications run at once. This is a memory ceiling
# wearing a count: multiply it by 64 MiB for the transient memory the token
# endpoint may hold under load. Unset means one per core, which is what a
# CPU-bound hash can actually use; lower it on a container with a memory limit.
# Callers past the ceiling wait, they are not refused.
# REGISTRE_VERIFY_CONCURRENCY=

# Optional — the declarative bootstrap. Unset means the database is the only
# source of clients. See seed.example.yaml.
# REGISTRE_SEED_FILE=/etc/registre/seed.yaml

# Journal log shipping. Both are required or nothing ships. The token is a
# per-app key from Journal's Keys page; the internal URL on la ruche is
# http://journal-api:4010/api and it must end in /api.
#
# Not optional in production: registre's protocol errors are the suite's auth
# audit trail, and they only reach Journal because main calls slog.SetDefault —
# zitadel/oidc emits them through the package-level slog and discards any
# logger it is handed.
# JOURNAL_URL=http://journal-api:4010/api
# JOURNAL_TOKEN=journal_registre_...

# The browser half of Journal. These reach the client build over
# GET /api/config rather than being baked into the bundle, so rotating the key
# is an environment change and not a rebuild. They are deliberately not the
# pair above: those are the server SDK's secret key, this pair is the
# origin-locked public kind that ships in a response to any visitor.
#
# Both or neither, and the URL must end in /api. Boot refuses either rule
# broken: a URL without a key reports nothing, a key without a URL has nowhere
# to report, and a URL missing /api is answered by Journal's own SPA catch-all
# with 200 and HTML, so the reports vanish without an error anywhere.
# JOURNAL_BROWSER_URL=https://journal.facile.studio/api
# JOURNAL_BROWSER_KEY=jbk_...

# Password recovery over SMTP. Unset means recovery is off: the endpoints still
# mount and still answer identically, they just send nothing, so an instance
# whose operators mint every account by hand is not carrying a broken feature.
# The names are the suite-wide convention facteur and facteur-ts both read, so
# ops documents one set for every app.
#
# The mail is handed to a goroutine before the SMTP round trip starts. That is
# not an optimisation: a synchronous send happens only when the address exists,
# so a slow server would answer "that address has an account" in latency, which
# is the enumeration the request path equalises argon2 to prevent.
# SMTP_HOST=smtp.example.net
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=noreply@facile.studio
# SMTP_FROM_NAME=Registre

# Read only by subcommands, never by the server, and deliberately absent from
# docker-compose.yml: they belong on a one-off `docker compose exec -e` and not
# on the service. Both are environment variables rather than flags because a
# flag lands in shell history and in ps output.
#
#   REGISTRE_USER_PASSWORD=...        registre user-create --email <address>
#   REGISTRE_BREAK_GLASS_PASSWORD=... registre break-glass --email <address>
