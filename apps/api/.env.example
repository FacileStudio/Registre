# Local development. The issuer is plain http, which registre tolerates only
# because APP_ENV is development.
APP_ENV=development
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/registre?sslmode=disable
PORT=4000
REGISTRE_ISSUER=http://127.0.0.1:4000
LOG_LEVEL=debug

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# A short lifecycle so rotation can be watched happening rather than reasoned
# about. Production defaults are in the root .env.example.
REGISTRE_ACCESS_TOKEN_TTL=5m
REGISTRE_KEY_ROTATION_INTERVAL=1h
REGISTRE_KEY_PUBLISH_DELAY=5m
REGISTRE_KEY_RETENTION=10m

# One per core by default. Two is plenty for development and keeps argon2's
# transient memory to 128 MiB.
REGISTRE_VERIFY_CONCURRENCY=2

# REGISTRE_SEED_FILE=../../seed.example.yaml
# REGISTRE_SEED_AGENT_CLAUDE_SECRET=
